{
  "name": "@ebgw/shopify-shared",
  "version": "0.4.0",
  "description": "Shared types, Zod schemas, constants and pure helpers for EBGW Collective's Shopify apps. Single source of truth for the size_chart metaobject schema.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JWCapitalVentures/ebgw-shopify-shared.git"
  },
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
